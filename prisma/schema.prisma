// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  // Optional, asked at sign-up; private
  homeRegion  String?
  homeCountry String?
  ageBracket  String?
  termsAcceptedAt DateTime? // when they agreed to the Terms of Use and Privacy Policy
  blockedAt   DateTime? // set by the site owner: can't sign in, and their trips and comments are hidden
  emailOptOut Boolean   @default(false) // unsubscribed from the owner's messages
  // Optional credit on shared trips (off by default: names stay hidden)
  showName    Boolean   @default(false)
  creditName  String?   // how to show them, e.g. "Rafi" or "@rafitravels"
  creditUrl   String?   @db.Text // optional link to their blog or Instagram (https only)
  lastSeenAt     DateTime? // last visit (updated at most hourly), for "members returning each month"
  authorThanksAt DateTime? // last monthly "people used your trip" email
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trips Trip[]
  sandboxTrips SandboxTrip[]
  savedPlaces  SavedPlace[]
  tripComments TripComment[]
  commentAgrees TripCommentAgree[]
  pendingImports PendingImport[]

  @@map("users")
}

model Trip {
  id          String    @id @default(cuid())
  title       String
  description String? @db.Text
  startDate   DateTime?
  endDate     DateTime?
  countries   String // JSON string of countries visited
  cities      String // JSON string of cities visited
  isPublic    Boolean   @default(true)
  isDraft     Boolean   @default(false) // true for draft trips, false for completed/shared trips
  coverImageUrl String? @db.Text // cover photo chosen when adding the trip (Google photo link)
  region      String?   // e.g. "Central America" (chosen when adding the trip)
  tripType    String?   // e.g. "Couple", "Multi-generational" (see TRIP_TYPES)
  travelInfo  String?   @db.Text // JSON: flights to the destination [{from,to,airline,flightNumber}]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  cities_data City[]

  @@map("trips")

  @@index([isPublic, isDraft, createdAt])
  @@index([userId, isDraft])
}

model City {
  id        String   @id @default(cuid())
  name      String
  country   String
  state     String?  // state / province, e.g. Newfoundland and Labrador
  area      String?  // travel area, e.g. Canadian Rockies, Tuscany
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tripId       String
  trip         Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  numberOfDays Int?   @default(1)
  arrival      String?  @db.Text // JSON: how they got to this city {mode,from,operator,details}

  hotels      Hotel[]
  restaurants Restaurant[]
  activities  Activity[]

  @@map("cities")

  @@index([name])
}

model Hotel {
  id        String   @id @default(cuid())
  name      String
  location  String
  rating    Int? // 1-5 stars
  review    String?  @db.Text // can hold a review plus place details (photo and map links)
  liked     Boolean? // true for liked, false for disliked, null for neutral
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stayType  String?  // "rental" for Airbnb/VRBO-style stays; null = hotel
  imageUrl  String? @db.Text // photo link for a place picked from search
  webUrl    String? @db.Text // Google Maps / TripAdvisor page for the place
  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@map("hotels")
}

model Restaurant {
  id        String   @id @default(cuid())
  name      String
  location  String
  rating    Int? // 1-5 stars
  review    String?  @db.Text // can hold a review plus place details (photo and map links)
  liked     Boolean? // true for liked, false for disliked, null for neutral
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dayNumber Int? // which day of the city stay (1, 2, 3...); null if unknown
  imageUrl  String? @db.Text // photo link for a place picked from search
  webUrl    String? @db.Text // Google Maps / TripAdvisor page for the place
  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@map("restaurants")
}

model Activity {
  id        String   @id @default(cuid())
  name      String
  location  String
  rating    Int? // 1-5 stars
  review    String?  @db.Text // can hold a review plus place details (photo and map links)
  liked     Boolean? // true for liked, false for disliked, null for neutral
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dayNumber Int? // which day of the city stay (1, 2, 3...); null if unknown
  imageUrl  String? @db.Text // photo link for a place picked from search
  webUrl    String? @db.Text // Google Maps / TripAdvisor page for the place
  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@map("activities")
}

// ---------- My Travel Sandbox ----------
// A planned trip in the user's sandbox (they can plan many at once)
model SandboxTrip {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  region    String?
  tripType  String?
  startDate String?  // YYYY-MM-DD, optional while planning
  endDate   String?
  notes     String?  @db.Text
  // "Help me plan": shared with all members for comments
  feedbackOpen     Boolean   @default(false)
  feedbackAsk      String?   @db.Text // what the planner wants advice on
  feedbackOpenedAt DateTime?
  backAskedAt      DateTime? // when we asked "back from your trip? share it"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  places   SavedPlace[]
  comments TripComment[]

  @@index([userId])
  @@map("sandbox_trips")
}

// A hotel / restaurant / activity saved into the sandbox from someone's trip
model SavedPlace {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sandboxTripId String?      // null = "Unsorted"
  sandboxTrip   SandboxTrip? @relation(fields: [sandboxTripId], references: [id], onDelete: SetNull)

  kind      String   // "hotel" | "restaurant" | "activity"
  name      String
  location  String?  @db.Text
  city      String?
  country   String?
  imageUrl  String?  @db.Text
  webUrl    String?  @db.Text
  stayType  String?  // "rental" for Airbnb/VRBO-style stays

  // From the trip it was found in
  sourceTripId    String?
  sourceTripTitle String?
  sourceUserName  String?
  sourceRating    Int?
  sourceReview    String?  @db.Text

  // The planner's own
  note      String?  @db.Text
  dayNumber Int?     // day within the city, once scheduled
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([sandboxTripId])
  @@map("saved_places")
}

// Counts paid API calls per month (e.g. "google-reviews:2026-11"), so the site can stop at a cap
model ApiUsage {
  key       String   @id
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("api_usage")
}

// A member's advice on a planned trip shared in "Help me plan"
model TripComment {
  id            String      @id @default(cuid())
  sandboxTripId String
  sandboxTrip   SandboxTrip @relation(fields: [sandboxTripId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  targetType  String  // "trip" | "city" | "place"
  targetKey   String? // city name, or the saved place's id
  targetLabel String? // what it was about, as shown then (place or city name)
  reaction    String  // e.g. "too_many_days", "skip", "swap", "add_place", "note"
  text        String? @db.Text
  suggestion  String? @db.Text // JSON: a suggested place (name, location, photo, link, kind, city)
  status      String  @default("open") // "open" | "accepted" | "dismissed"
  createdAt   DateTime @default(now())

  agrees TripCommentAgree[]

  @@index([sandboxTripId])
  @@index([userId, createdAt])
  @@map("trip_comments")
}

model TripCommentAgree {
  id        String      @id @default(cuid())
  commentId String
  comment   TripComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([commentId, userId])
  @@index([userId, createdAt])
  @@map("trip_comment_agrees")
}

// Owner's emails to members (a log of what was sent)
model EmailCampaign {
  id        String   @id @default(cuid())
  subject   String
  body      String   @db.Text
  audience  String   @db.Text // JSON description of who it went to
  sentCount Int      @default(0)
  failed    Int      @default(0)
  createdAt DateTime @default(now())

  @@map("email_campaigns")
}

// Owner's banner message shown on the site
model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String   @db.Text
  linkUrl   String?
  linkLabel String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("announcements")
}

// A trip read from an email sent to trips@tripshare.org, waiting for its member to check and save it
model PendingImport {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      String   @db.LongText // ImportedTrip JSON
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("pending_imports")
}
